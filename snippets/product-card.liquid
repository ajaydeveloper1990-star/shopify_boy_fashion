<article class="product-card reveal">
  <a class="product-card__media" href="{{ card_product.url }}">
    {% if card_product.featured_media %}{{ card_product.featured_media | image_url: width: 900 | image_tag: widths: '240,360,540,720,900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: card_product.featured_media.alt | default: card_product.title | escape }}{% else %}<div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}
    {% if card_product.compare_at_price > card_product.price %}<span class="badge">Sale</span>{% elsif card_product.available == false %}<span class="badge">Sold out</span>{% endif %}
  </a>
  <div class="product-card__details"><h3 class="product-card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3><div>{% render 'price', product: card_product %}</div></div>
</article>