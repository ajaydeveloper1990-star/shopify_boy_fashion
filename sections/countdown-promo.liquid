{% comment %} FABRICA Banners section: Countdown Promo. {% endcomment %}<section id="fab-countdown-promo-{{ section.id }}" class="fab-section fab-section--countdown-promo fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px"><div class="fab-section__inner"><div class="fab-section__banner fab-section__banner--overlay">{% if section.settings.image != blank %}<div class="fab-section__media">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1800', alt: section.settings.image_alt | escape }}</div>{% endif %}<div class="fab-section__copy"><p class="fab-section__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="fab-section__heading">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div><a class="fab-section__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} ↗</a></div></div></div></section>
{% schema %}
{"name":"Countdown Promo","tag":"section","class":"fab-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FABRICA / THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Countdown Promo"},{"type":"richtext","id":"body","label":"Description","default":"<p>Discover considered essentials and modern menswear made to wear on repeat.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Countdown Promo"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"color_scheme","label":"Color scheme","default":"light","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true}],"presets":[{"name":"Countdown Promo","category":"Banners"}]}
{% endschema %}