<section class="section page-width"><h1 class="heading-lg">{{ collections_title | default: 'Collections' | escape }}</h1><div class="collection-tiles">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="collection-tile" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: widths: '300,500,700,900', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title | escape }}{% endif %}<span class="collection-tile__title">{{ collection.title | escape }}</span></a>{% endunless %}{% endfor %}</div></section>{% schema %}{"name":"Collection list","settings":[]}{% endschema %}