<article class="section page-width" style="max-width:900px"><p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</p><h1 class="heading-lg">{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', loading: 'eager', alt: article.image.alt | default: article.title | escape }}{% endif %}<div class="rte">{{ article.content }}</div><p><a href="{{ blog.url }}">← Back to {{ blog.title | escape }}</a></p></article>{% schema %}{"name":"Main article","settings":[]}{% endschema %}