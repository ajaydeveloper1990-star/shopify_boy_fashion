{% comment %} FABRICA Text section: Text Columns. {% endcomment %}<section id="fab-text-columns-{{ section.id }}" class="fab-section fab-section--text-columns fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px"><div class="fab-section__inner"><div class="fab-section__copy"><p class="fab-section__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="fab-section__heading">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div>{% if section.settings.button_label != blank %}<a class="fab-section__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} ↗</a>{% endif %}</div><div class="fab-section__benefits"><div><h3>Designed with purpose</h3><p>Details that do the work.</p></div><div><h3>Made for everyday</h3><p>Versatility for repeat wear.</p></div><div><h3>Less, considered</h3><p>A focused wardrobe of essentials.</p></div></div></div></section>
{% schema %}
{"name":"Text Columns","tag":"section","class":"fab-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FABRICA / THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Text Columns"},{"type":"richtext","id":"body","label":"Text","default":"<p>Discover considered essentials and modern menswear made to wear on repeat.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"color_scheme","label":"Color scheme","default":"light","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true}],"presets":[{"name":"Text Columns","category":"Text"}]}
{% endschema %}