<header class="site-header">
  <div class="page-width header-inner">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MainNavigation"><span aria-hidden="true">☰</span><span class="visually-hidden">Menu</span></button>
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 360 | image_tag: widths: '120,180,240,360', alt: shop.name }}{% else %}{{ settings.brand_name | default: shop.name | escape }}{% endif %}</a>
    <nav class="nav-wrap" id="MainNavigation" data-mobile-nav aria-label="Main navigation">
      <ul class="nav-list">{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{% endfor %}</ul>
    </nav>
    <div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Search">Search</a><a class="account-link" href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}
{% endschema %}