{% comment %} FABRICA Layout section: Multicolumn Layout. {% endcomment %}<section id="fab-multicolumn-layout-{{ section.id }}" class="fab-section fab-section--multicolumn-layout fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px"><div class="fab-section__inner"><div class="fab-section__layout"><div class="fab-section__copy"><p class="fab-section__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="fab-section__heading">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div></div></div></div></section>
{% schema %}
{"name":"Multicolumn Layout","tag":"section","class":"fab-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FABRICA / THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Multicolumn Layout"},{"type":"richtext","id":"body","label":"Description","default":"<p>Discover considered essentials and modern menswear made to wear on repeat.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"color_scheme","label":"Color scheme","default":"light","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true}],"presets":[{"name":"Multicolumn Layout","category":"Layout"}]}
{% endschema %}