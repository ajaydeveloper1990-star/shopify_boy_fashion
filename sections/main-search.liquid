<section class="section page-width"><h1 class="heading-lg">Search</h1><form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:.5rem;max-width:600px;margin-bottom:2rem"><label class="visually-hidden" for="SearchInput">Search products and pages</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." style="flex:1;min-width:0;padding:1rem;border:1px solid #aaa"><button class="button" type="submit">Search</button></form>{% if search.performed %}<p class="muted">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="product-grid" style="--columns:4">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% else %}<article class="product-card"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 150 }}</p></article>{% endif %}{% else %}<p>No results found. Try another search.</p>{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]}{% endschema %}