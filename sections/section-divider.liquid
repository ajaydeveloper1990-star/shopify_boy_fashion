{% comment %} FABRICA Layout section: Section Divider. {% endcomment %}<section id="fab-section-divider-{{ section.id }}" class="fab-section fab-section--section-divider fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px"><div class="fab-section__inner"><div class="fab-section__divider" role="separator"><span>{{ section.settings.heading | escape }}</span></div></div></section>
{% schema %}
{"name":"Section Divider","tag":"section","class":"fab-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FABRICA / THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Section Divider"},{"type":"richtext","id":"body","label":"Description","default":"<p>Discover considered essentials and modern menswear made to wear on repeat.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"color_scheme","label":"Color scheme","default":"light","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true}],"presets":[{"name":"Section Divider","category":"Layout"}]}
{% endschema %}