<section class="section page-width"><h1 class="heading-lg">Your bag <span class="muted">({{ cart.item_count }})</span></h1>{% if cart == empty %}<div class="empty-state"><p>Your cart is currently empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate>{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: widths: '100,160,240', alt: item.image.alt | default: item.product.title | escape }}{% endif %}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a><p class="muted">{{ item.variant.title | escape }}</p><label for="CartQty-{{ item.key }}">Qty</label><input id="CartQty-{{ item.key }}" data-quantity type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:80px;padding:.5rem"><p><a href="{{ item.url_to_remove }}">Remove</a></p></div><div class="cart-line-price">{{ item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-summary"><label for="CartNote">Order note</label><textarea id="CartNote" name="note" rows="3" style="width:100%;padding:.8rem">{{ cart.note | escape }}</textarea><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="muted">Shipping, taxes, and discounts are calculated at checkout.</p><button class="button" type="submit" name="update">Update cart</button> <button class="button" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}