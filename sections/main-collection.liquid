<section class="section page-width">
  <header class="section-head"><div><p class="eyebrow">FABRICA COLLECTION</p><h1 class="heading-lg">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte muted">{{ collection.description }}</div>{% endif %}</div><span class="muted">{{ collection.products_count }} products</span></header>
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="product-grid" style="--columns: {{ section.settings.columns }}">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<p>No products found in this collection.</p>{% endfor %}</div>
    {% if paginate.pages > 1 %}<nav class="section" aria-label="Pagination">{% if paginate.previous %}<a class="button" href="{{ paginate.previous.url }}">Previous</a>{% endif %} <span>{{ paginate.current_page }} / {{ paginate.pages }}</span> {% if paginate.next %}<a class="button" href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Main collection","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":40,"step":4,"default":16},{"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"}]}
{% endschema %}