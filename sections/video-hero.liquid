{% comment %} FABRICA video hero. Select a Shopify-hosted video in the theme editor; the image is used as a poster/fallback. {% endcomment %}
<section id="fab-video-hero-{{ section.id }}" class="fab-section fab-section--video-hero fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px">
  <div class="fab-section__inner">
    <div class="fab-video-hero">
      <div class="fab-video-hero__media">
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: image_size: '2000x', autoplay: section.settings.autoplay, loop: section.settings.loop, muted: true, controls: section.settings.show_controls, playsinline: true, class: 'fab-video-hero__video' }}
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 2000', sizes: '100vw', alt: section.settings.image.alt | escape }}
        {% else %}
          <div class="fab-section__placeholder" role="img" aria-label="Choose a video or image in the theme editor"></div>
        {% endif %}
      </div>
      <div class="fab-video-hero__copy">
        {% if section.settings.eyebrow != blank %}<p class="fab-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="fab-section__heading">{{ section.settings.heading | escape }}</h2>
        <div class="fab-section__body rte">{{ section.settings.body }}</div>
        {% if section.settings.button_label != blank %}<a class="fab-section__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} ↗</a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Video Hero",
  "tag": "section",
  "class": "fab-section-wrapper",
  "settings": [
    {"type":"video","id":"video","label":"Shopify-hosted video"},
    {"type":"image_picker","id":"image","label":"Poster image / fallback"},
    {"type":"checkbox","id":"autoplay","label":"Autoplay video (muted)","default":true},
    {"type":"checkbox","id":"loop","label":"Loop video","default":true},
    {"type":"checkbox","id":"show_controls","label":"Show video controls","default":false},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEHIND THE FABRICA EDIT"},
    {"type":"text","id":"heading","label":"Heading","default":"A closer look at the details."},
    {"type":"richtext","id":"body","label":"Description","default":"<p>Explore the textures, fits and considered details behind our everyday essentials.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop the edit"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"select","id":"color_scheme","label":"Color scheme","default":"dark","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},
    {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},
    {"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true}
  ],
  "presets":[{"name":"Video Hero","category":"Banners"}]
}
{% endschema %}