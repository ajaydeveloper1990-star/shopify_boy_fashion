{% if section.settings.show_announcement %}
  <div class="announcement" role="status">{{ section.settings.text | escape }}{% if section.settings.link != blank %} <a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div>
{% endif %}
{% schema %}
{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Message","default":"COMPLIMENTARY SHIPPING ON ORDERS OVER $100"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Shop now"}],"presets":[{"name":"Announcement bar"}]}
{% endschema %}