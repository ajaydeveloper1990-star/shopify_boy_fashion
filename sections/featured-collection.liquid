{% assign featured_collection = section.settings.collection %}
<section class="section page-width">
  <div class="section-head"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="heading-lg">{{ section.settings.heading | escape }}</h2></div>{% if featured_collection != blank %}<a href="{{ featured_collection.url }}" class="eyebrow">View all ↗</a>{% endif %}</div>
  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="product-grid" style="--columns: {{ section.settings.columns }}">{% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'product-card', card_product: product %}{% endfor %}</div>
  {% else %}<p class="muted">Choose a collection with products in this section's settings.</p>{% endif %}
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED FOR YOU"},{"type":"text","id":"heading","label":"Heading","default":"The essentials"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":12,"step":1,"default":4},{"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}