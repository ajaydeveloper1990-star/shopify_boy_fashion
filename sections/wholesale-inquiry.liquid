{% comment %} FABRICA Forms section: Wholesale Inquiry. {% endcomment %}<section id="fab-wholesale-inquiry-{{ section.id }}" class="fab-section fab-section--wholesale-inquiry fab-section--{{ section.settings.color_scheme }}{% if section.settings.enable_animation %} fab-reveal{% endif %}" style="--fab-pad-top:{{ section.settings.padding_top }}px;--fab-pad-bottom:{{ section.settings.padding_bottom }}px"><div class="fab-section__inner"><div class="fab-section__form-layout"><div class="fab-section__copy"><p class="fab-section__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="fab-section__heading">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div></div><div class="fab-section__form">{% form 'contact', id: 'FabForm-' | append: section.id %}{% if form.posted_successfully? %}<p role="status" class="fab-section__success">{{ section.settings.success_message | escape }}</p>{% endif %}{{ form.errors | default_errors }}<label class="fab-section__field"><span>How can we help?</span><textarea name="contact[body]" rows="4"></textarea></label><label class="fab-section__field"><span>Name</span><input name="contact[name]" autocomplete="name"></label><label class="fab-section__field"><span>{{ section.settings.email_label | escape }}</span><input type="email" name="contact[email]" autocomplete="email" required></label><button class="fab-section__button" type="submit">{{ section.settings.button_label | escape }}</button>{% endform %}</div></div></div></section>
{% schema %}
{"name":"Wholesale Inquiry","tag":"section","class":"fab-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FABRICA / THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Wholesale Inquiry"},{"type":"richtext","id":"body","label":"Description","default":"<p>Discover considered essentials and modern menswear made to wear on repeat.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Send inquiry"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"color_scheme","label":"Color scheme","default":"light","options":[{"value":"light","label":"White"},{"value":"dark","label":"Black"},{"value":"charcoal","label":"Charcoal"}]},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"checkbox","id":"enable_animation","label":"Reveal animation","default":true},{"type":"text","id":"success_message","label":"Success message","default":"Thank you. We’ll be in touch soon."},{"type":"text","id":"email_label","label":"Email field label","default":"Email address"}],"presets":[{"name":"Wholesale Inquiry","category":"Forms"}]}
{% endschema %}