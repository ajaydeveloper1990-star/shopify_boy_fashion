<section class="section page-width"><h1 class="heading-lg">{{ blog.title | escape }}</h1>{% paginate blog.articles by 12 %}<div class="product-grid" style="--columns:3">{% for article in blog.articles %}<article class="product-card">{% if article.image %}<a class="product-card__media" href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: widths: '300,500,700,900', loading: 'lazy', alt: article.image.alt | default: article.title | escape }}</a>{% endif %}<div class="product-card__details"><p class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</p><h2 class="product-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p><a class="eyebrow" href="{{ article.url }}">Read article ↗</a></div></article>{% else %}<p>No articles published yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="section" aria-label="Pagination">{% if paginate.previous %}<a class="button" href="{{ paginate.previous.url }}">Previous</a>{% endif %} <span>{{ paginate.current_page }} / {{ paginate.pages }}</span> {% if paginate.next %}<a class="button" href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Main blog","settings":[]}{% endschema %}