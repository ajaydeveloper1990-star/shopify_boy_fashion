<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#111111">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    <title>{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    {{ content_for_header }}
    <style>
      :root{--color-bg:{{ settings.color_background | default: '#FFFFFF' }};--color-text:{{ settings.color_text | default: '#111111' }};--color-muted:{{ settings.color_muted | default: '#666666' }};--color-panel:{{ settings.color_panel | default: '#F5F5F3' }};--color-border:{{ settings.color_border | default: '#DEDEDB' }};--page-width:{{ settings.page_width | default: 1440 }}px}
    </style>
    {{ 'fabrica.css' | asset_url | stylesheet_tag }}
    {{ 'fabrica-section-library.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'fabrica.js' | asset_url }}" defer></script>
    <script src="{{ 'fabrica-section-library.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
  </body>
</html>